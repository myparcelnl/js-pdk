{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "npmScope": "myparcel-pdk",
  "affected": {
    "defaultBase": "main"
  },
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/libs/build-vite/index.js",
      "{workspaceRoot}/tsconfig.base.json",
      "{projectRoot}/*.cjs",
      "{projectRoot}/*.js",
      "{projectRoot}/*.mjs",
      "{projectRoot}/*.ts",
      "{projectRoot}/package.json",
      "{projectRoot}/src/**/*",
      "{projectRoot}/tsconfig.base.json"
    ],
    "prod": [
      "default",
      "!{projectRoot}/**/*.snap",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/__mocks__/**/*",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/vitest.config.*"
    ],
    "test": ["default"],
    "lint": [
      "prod",
      "{workspaceRoot}/.eslintignore",
      "{workspaceRoot}/.eslintrc*"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": ["prod", "^prod"],
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/tsconfig.build.tsbuildinfo"
      ]
    },
    "build:dev": {
      "inputs": ["prod", "^prod"],
      "dependsOn": ["^build:dev"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/tsconfig.build.tsbuildinfo"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "eslint --cache --cache-location {projectRoot}/.eslintcache {projectRoot}"
      },
      "inputs": ["lint"],
      "outputs": ["{projectRoot}/.eslintcache"]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "eslint --cache --cache-location {projectRoot}/.eslintcache --fix {projectRoot}"
      },
      "inputs": ["lint"],
      "outputs": ["{projectRoot}/.eslintcache", "{projectRoot}/src/**/*"]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --coverage --passWithNoTests"
      },
      "inputs": ["^test"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/junit.xml"]
    },
    "test:run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --passWithNoTests"
      },
      "inputs": ["^test"],
      "outputs": ["{projectRoot}/junit.xml"]
    },
    "test:update": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run -u --passWithNoTests"
      },
      "inputs": ["^test"],
      "outputs": [
        "{projectRoot}/src/__tests__/__snapshots__",
        "{projectRoot}/junit.xml"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "rimraf dist coverage .eslintcache tsconfig.build.tsbuildinfo"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest --passWithNoTests"
      }
    }
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "parallel": 10,
        "cacheableOperations": [
          "build",
          "build:dev",
          "lint",
          "lint:fix",
          "test:run",
          "test:update",
          "test:coverage"
        ]
      }
    }
  },
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false
    }
  },
  "release": {
    "groups": {
      "admin": {
        "projects": [
          "@myparcel-dev/pdk-admin",
          "@myparcel-dev/pdk-admin-component-tests",
          "@myparcel-dev/pdk-admin-js",
          "@myparcel-dev/pdk-admin-preset-bootstrap4",
          "@myparcel-dev/pdk-admin-preset-dashicons",
          "@myparcel-dev/pdk-admin-preset-default",
          "@myparcel-dev/pdk-admin-preset-fontawesome"
        ],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "admin@{version}"
        }
      },
      "app-builder": {
        "projects": ["@myparcel-dev/pdk-app-builder"],
        "releaseTag": {
          "pattern": "app-builder@{version}"
        }
      },
      "checkout": {
        "projects": [
          "@myparcel-dev/pdk-checkout",
          "@myparcel-dev/pdk-checkout-js",
          "@myparcel-dev/pdk-checkout-common",
          "@myparcel-dev/pdk-checkout-delivery-options",
          "@myparcel-dev/pdk-checkout-separate-address-fields",
          "@myparcel-dev/pdk-checkout-tax-fields"
        ],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "checkout@{version}"
        }
      },
      "common": {
        "projects": ["@myparcel-dev/pdk-common"],
        "releaseTag": {
          "pattern": "{projectName}@{version}"
        },
        "projectsRelationship": "independent"
      }
    },
    "version": {
      "conventionalCommits": true
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": false,
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md",
        "createRelease": "github"
      }
    },
    "git": {
      "commitMessage": "chore: release [skip ci]",
      "push": true
    }
  }
}
