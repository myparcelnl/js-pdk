{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "npmScope": "myparcel-pdk",
  "affected": {
    "defaultBase": "main"
  },
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/libs/build-vite/index.js",
      "{workspaceRoot}/tsconfig.base.json",
      "{projectRoot}/*.cjs",
      "{projectRoot}/*.js",
      "{projectRoot}/*.mjs",
      "{projectRoot}/*.ts",
      "{projectRoot}/package.json",
      "{projectRoot}/src/**/*",
      "{projectRoot}/tsconfig.base.json"
    ],
    "prod": [
      "default",
      "!{projectRoot}/**/*.snap",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/__mocks__/**/*",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/vitest.config.*"
    ],
    "test": ["default"],
    "lint": [
      "prod",
      "{workspaceRoot}/.eslintignore",
      "{workspaceRoot}/.eslintrc*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["prod", "^prod"],
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/tsconfig.build.tsbuildinfo"
      ]
    },
    "build:dev": {
      "cache": true,
      "inputs": ["prod", "^prod"],
      "dependsOn": ["^build:dev"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/tsconfig.build.tsbuildinfo"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": ["lint"],
      "outputs": ["{projectRoot}/.eslintcache"]
    },
    "lint:fix": {
      "cache": true,
      "inputs": ["lint"],
      "outputs": ["{projectRoot}/.eslintcache", "{projectRoot}/src/**/*"]
    },
    "test:coverage": {
      "cache": true,
      "inputs": ["^test"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/junit.xml"]
    },
    "test:run": {
      "cache": true,
      "inputs": ["^test"],
      "outputs": ["{projectRoot}/junit.xml"]
    },
    "test:update": {
      "cache": true,
      "inputs": ["^test"],
      "outputs": [
        "{projectRoot}/src/__tests__/__snapshots__",
        "{projectRoot}/junit.xml"
      ]
    }
  },
  "parallel": 10,
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  }
}
