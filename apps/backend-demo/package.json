{
  "name": "@myparcel-dev/pdk-backend-demo",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/myparcelnl/js-pdk.git",
    "directory": "apps/backend-demo"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm translations:init && nitropack build",
    "postinstall": "nitropack prepare",
    "serve": "pnpm translations:init && nitropack dev",
    "translations:import": "pdk-builder translations",
    "translations:init": "test -f data/translations/en.json || pnpm translations:import"
  },
  "devDependencies": {
    "@myparcel-dev/pdk-app-builder": "workspace:*",
    "@myparcel-dev/pdk-common": "workspace:*",
    "@myparcel-dev/ts-utils": "^1.15.0",
    "@types/node": "^20.0.0",
    "h3": "^1.5.0",
    "nitropack": "^2.2.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "{projectRoot}/nitro.config.ts",
          "{projectRoot}/routes/**/*",
          "{projectRoot}/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.netlify/functions-internal",
          "{projectRoot}/.output",
          "{projectRoot}/.nitro"
        ]
      },
      "clean": {},
      "lint": {},
      "lint:fix": {}
    }
  }
}
